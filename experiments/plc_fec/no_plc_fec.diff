       int len, opus_val16 * OPUS_RESTRICT pcm, int frame_size, ec_dec *dec, int accum
@@ -1293,9 +1309,11 @@
       for (i=0;i<C*nbEBands;i++)
          oldBandE[i] = -QCONST16(28.f,DB_SHIFT);
    }
+#ifndef ECHO_NO_PLC
    if (st->prefilter_and_fold) {
       prefilter_and_fold(st, N);
