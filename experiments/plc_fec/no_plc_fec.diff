+#ifdef ECHO_NO_PLC
+/* Echo Mini: no packet-loss concealment. A missing frame (only produced by
+   SILK<->CELT mode transitions in a lossless file) is rendered as silence. */
+static void celt_decode_lost(CELTDecoder * OPUS_RESTRICT st, int N, int LM)
+{
+   int c = 0;
+   const int overlap = st->mode->overlap;
+   do {
+      celt_sig *m = st->_decode_mem + c*(DECODE_BUFFER_SIZE+overlap);
+      OPUS_MOVE(m, m+N, DECODE_BUFFER_SIZE-N+overlap);
+      OPUS_CLEAR(m+DECODE_BUFFER_SIZE-N, N+overlap);
+   } while (++c<st->channels);
+   st->loss_duration = IMIN(10000, st->loss_duration+(1<<LM));
+}
+#else
 static void celt_decode_lost(CELTDecoder * OPUS_RESTRICT st, int N, int LM
 #ifdef ENABLE_DEEP_PLC
       ,LPCNetPLCState *lpcnet
