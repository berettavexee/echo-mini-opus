   return -1;
 }
 
diff --git a/info.c b/info.c
index be5df49..7852f02 100644
--- a/info.c
+++ b/info.c
@@ -128,10 +128,14 @@ void vorbis_info_clear(vorbis_info *vi){
 
     if(ci->floor_param){
       for(i=0;i<ci->floors;i++) /* unpack does the range checking */
+#ifdef ECHO_NO_FLOOR0
+	if(ci->floor_param[i])floor1_free_info(ci->floor_param[i]);
+#else
 	if(ci->floor_type[i])
 	  floor1_free_info(ci->floor_param[i]);
 	else
 	  floor0_free_info(ci->floor_param[i]);
+#endif
       _ogg_free(ci->floor_param);
       _ogg_free(ci->floor_type);
     }
@@ -244,10 +248,15 @@ static int _vorbis_unpack_books(vorbis_info *vi,oggpack_buffer *opb){
   for(i=0;i<ci->floors;i++){
     ci->floor_type[i]=oggpack_read(opb,16);
     if(ci->floor_type[i]<0 || ci->floor_type[i]>=VI_FLOORB)goto err_out;
+#ifdef ECHO_NO_FLOOR0
+    if(!ci->floor_type[i])goto err_out;          /* floor 0 (LSP, unused since 2001): not supported */
+    ci->floor_param[i]=floor1_info_unpack(vi,opb);
+#else
     if(ci->floor_type[i])
       ci->floor_param[i]=floor1_info_unpack(vi,opb);
     else
       ci->floor_param[i]=floor0_info_unpack(vi,opb);
+#endif
     if(!ci->floor_param[i])goto err_out;
   }
 
