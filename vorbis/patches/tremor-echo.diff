diff --git a/codebook.c b/codebook.c
index ec7602e..5a11844 100644
--- a/codebook.c
+++ b/codebook.c
@@ -186,6 +186,24 @@ static int _make_words(char *l,long n,ogg_uint32_t *r,long quantvals,
   return 0;
 }
 
+#ifdef ECHO_HEAP_ALLOCA
+/* ECHO MINI: the HiFi core has an 8 KB stack; the header-time scratch buffers (up to
+   8*entries bytes) go to the heap and are released at the end of vorbis_book_unpack(). */
+static void *echo_scratch[4];
+static int echo_nscratch;
+static void *echo_scratch_alloc(size_t n){
+  void *p=_ogg_malloc(n);
+  if(echo_nscratch<4)echo_scratch[echo_nscratch++]=p;
+  return p;
+}
+static void echo_scratch_free(void){
+  while(echo_nscratch)_ogg_free(echo_scratch[--echo_nscratch]);
+}
+#define SCRATCH_ALLOC(n) echo_scratch_alloc(n)
+#else
+#define SCRATCH_ALLOC(n) alloca(n)
+#endif
+
 static int _make_decode_table(codebook *s,char *lengthlist,long quantvals,
 			      oggpack_buffer *opb,int maptype){
   int i;
